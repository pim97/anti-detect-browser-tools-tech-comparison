# 6. Binary section analysis
RUN cat > /audit/06_binary_analysis.sh << 'SCRIPT'
#!/bin/bash
set -e
echo "================================================================"
echo "  TEST 6: Binary Section Analysis"
echo "================================================================"
echo ""

BINARY=$(python3 /audit/_binary_path.py)

echo "--- ELF section headers ---"
readelf -S "$BINARY" 2>/dev/null | head -40 || objdump -h "$BINARY" 2>/dev/null | head -40 || echo "(readelf/objdump not available)"
echo ""

echo "--- Shared library dependencies ---"
ldd "$BINARY" 2>/dev/null | head -40 || echo "(ldd not available)"
echo ""

echo "--- Suspicious shared libraries (non-standard for Firefox) ---"
ldd "$BINARY" 2>/dev/null | grep -vE 'linux-vdso|libpthread|libc\.so|libm\.so|libdl|librt|libgcc|libstdc\+\+|ld-linux|libX|libxcb|libdrm|libgbm|libEGL|libGL|libnss|libnspr|libsmime|libssl|libplc|libplds|libatk|libcups|libdbus|libdbus-glib|libpango|libcairo|libgdk|libgtk|libgio|libglib|libgobject|libfontconfig|libfreetype|libasound|libpulse|libexpat|libffi|libz\.|libpcre|libpng|libharfbuzz|libbrotli|libjpeg|libwebp|libsecret|libresolv|libselinux|libmount|libblkid|libwayland|libxkbcommon|libepoxy|libfribidi|libthai|libdatrie|libpixman|libuuid|libxshmfence|libxrandr|libxcomposite|libxdamage|libxfixes|libxext|libxrender|libxi\b|libxcursor|libxtst|libxt\b|libpci|libudev|libsystemd|liblzma|libbz2|libsqlite|libgdk_pixbuf' | \
    head -20 || echo "(none — all standard libraries)"
echo ""

echo "--- Binary file type ---"
file "$BINARY"
echo ""

echo "--- Code signing / debug info ---"
readelf -n "$BINARY" 2>/dev/null | head -20 || echo "(no notes section)"
echo ""

echo "--- application.ini (if shipped alongside) ---"
APP_INI="$(dirname "$BINARY")/application.ini"
if [ -f "$APP_INI" ]; then
    cat "$APP_INI"
else
    echo "(no application.ini found at $APP_INI)"
fi
echo ""
SCRIPT

# 7. Memory/environment sniffing test
RUN cat > /audit/07_env_sniff_test.sh << 'SCRIPT'
