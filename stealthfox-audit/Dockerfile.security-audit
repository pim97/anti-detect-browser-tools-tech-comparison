# 8. Outbound connection test with firewall
RUN cat > /audit/08_blocked_network_test.sh << 'SCRIPT'
#!/bin/bash
set -e
echo "================================================================"
echo "  TEST 8: Behavior When Network is Blocked"
echo "================================================================"
echo ""
echo "Testing if browser crashes or behaves differently without network..."
echo "(Malware often fails when it can't phone home)"
echo ""

# Start Xvfb
Xvfb :99 -screen 0 1920x1080x24 > /dev/null 2>&1 &
export DISPLAY=:99
sleep 1

# Block all outbound traffic (except loopback)
iptables -A OUTPUT -o lo -j ACCEPT 2>/dev/null || true
iptables -A OUTPUT -j DROP 2>/dev/null || true

echo "Network blocked via iptables. Launching browser..."

timeout 25 python3 -u << 'PYEOF' 2>&1
import time
from stealthfox import Stealthfox

try:
    with Stealthfox(headless=False) as browser:
        page = browser.new_page()
        page.goto("about:blank")
        print("PASS: Browser launched successfully with network blocked")
        time.sleep(5)
    print("PASS: Browser closed cleanly")
except Exception as e:
    print(f"RESULT: Browser behavior with network blocked: {e}")
PYEOF

# Restore network
iptables -F 2>/dev/null || true
echo ""
SCRIPT

# 9. VirusTotal hash lookup
RUN cat > /audit/09_virustotal.sh << 'SCRIPT'
#!/bin/bash
set -e
echo "================================================================"
echo "  TEST 9: VirusTotal Hash Lookup"
echo "================================================================"
echo ""

BINARY=$(python3 /audit/_binary_path.py)
HASH=$(sha256sum "$BINARY" | cut -d' ' -f1)

echo "Binary SHA-256: $HASH"
echo ""

# Check if VT API key is provided
if [ -z "$VT_API_KEY" ]; then
    echo "No VirusTotal API key provided."
    echo ""
    echo "To enable this test, run with:"
    echo "  docker run --rm --cap-add=NET_ADMIN -e VT_API_KEY=your_key stealthfox-audit"
    echo ""
    echo "You can get a free API key at: https://www.virustotal.com/gui/my-apikey"
    echo ""
    echo "Manual check — paste this hash into VirusTotal:"
    echo "  https://www.virustotal.com/gui/file/$HASH"
    echo ""
    echo "SKIPPED: No API key"
else
    echo "Querying VirusTotal API..."
    echo ""

    RESPONSE=$(curl -s --max-time 30 \
        -H "x-apikey: $VT_API_KEY" \
        "https://www.virustotal.com/api/v3/files/$HASH" 2>/dev/null)

    if echo "$RESPONSE" | grep -qi '"not.found"'; then
        echo "File NOT in VirusTotal database (never submitted)."
        echo ""
        echo "This means nobody has uploaded this binary to VT before."
        echo "You can upload it manually at: https://www.virustotal.com/gui/home/upload"
        echo ""
        echo "RESULT: NOT FOUND (not necessarily bad — just never scanned)"
    elif echo "$RESPONSE" | grep -q '"malicious"'; then
        MALICIOUS=$(echo "$RESPONSE" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['data']['attributes']['last_analysis_stats']['malicious'])" 2>/dev/null || echo "?")
        UNDETECTED=$(echo "$RESPONSE" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['data']['attributes']['last_analysis_stats']['undetected'])" 2>/dev/null || echo "?")
        TOTAL=$(echo "$RESPONSE" | python3 -c "import sys,json; d=json.load(sys.stdin); s=d['data']['attributes']['last_analysis_stats']; print(sum(s.values()))" 2>/dev/null || echo "?")
        HARMLESS=$(echo "$RESPONSE" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['data']['attributes']['last_analysis_stats']['harmless'])" 2>/dev/null || echo "?")
        SUSPICIOUS=$(echo "$RESPONSE" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['data']['attributes']['last_analysis_stats']['suspicious'])" 2>/dev/null || echo "?")

        echo "--- VirusTotal Results ---"
        echo "  Malicious:   $MALICIOUS / $TOTAL engines"
        echo "  Suspicious:  $SUSPICIOUS / $TOTAL engines"
        echo "  Harmless:    $HARMLESS / $TOTAL engines"
        echo "  Undetected:  $UNDETECTED / $TOTAL engines"
        echo ""

        if [ "$MALICIOUS" != "?" ] && [ "$MALICIOUS" -gt 0 ] 2>/dev/null; then
            echo "--- Engines that flagged it ---"
            echo "$RESPONSE" | python3 -c "
import sys, json
d = json.load(sys.stdin)
results = d['data']['attributes']['last_analysis_results']
for engine, result in sorted(results.items()):
    if result['category'] in ('malicious', 'suspicious'):
        print(f\"  {engine}: {result['result']} ({result['category']})\")
" 2>/dev/null || echo "  (could not parse engine details)"
            echo ""

            if [ "$MALICIOUS" -le 3 ] 2>/dev/null; then
                echo "WARNING: Low detection count ($MALICIOUS engines) — likely false positives"
                echo "Common for patched/modified Firefox builds"
            else
                echo "CRITICAL: $MALICIOUS engines flagged this binary as malicious!"
                echo "Review the detections carefully before using this binary."
            fi
        else
            echo "PASS: 0 engines flagged this binary as malicious"
        fi
    else
        echo "Unexpected API response. Raw output:"
        echo "$RESPONSE" | head -20
    fi
    echo ""
    echo "Full report: https://www.virustotal.com/gui/file/$HASH"
fi
echo ""
SCRIPT

